# Set the final public domain before deployment. No guessed official domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Put real values in .env.local or Vercel environment settings.
GROQ_API_KEY=
# Ordered primary model, fallback model. Choose models enabled for your Groq account.
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# Required to enable chat on Vercel: shared 10 requests/minute limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# A random secret (at least 32 characters) for hashing rate-limit IP identifiers.
CHAT_RATE_LIMIT_SECRET=
# Only set for a self-hosted trusted proxy that overwrites this header.
# Vercel automatically uses its own x-vercel-forwarded-for header.
CHAT_TRUSTED_IP_HEADER=
